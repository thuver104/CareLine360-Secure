{
  "info": {
    "_postman_id": "oauth-security-tests-001",
    "name": "CareLine360 - OAuth Security Control Tests",
    "description": "Security evidence-gathering collection for the standalone Google OAuth/OIDC security validators in server/middleware/oauthSecurity.js, exercised via the TEMPORARY testing endpoint POST /api/auth/oauth/security-test (server/controllers/oauthSecurityTestController.js). This does NOT exercise the real Google OAuth authorization-code flow, ID-token verification, or session/JWT issuance — those are owned by other team members and are not implemented here. This endpoint and route must be removed before production deployment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. State (CSRF) Validation",
      "item": [
        {
          "name": "State - valid matching state",
          "id": "oauth-state-valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('valid is true', function () { pm.expect(pm.response.json().valid).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test\": \"state\",\n  \"receivedState\": \"abc123\",\n  \"expectedState\": \"abc123\"\n}"
            },
            "url": {
              "raw": "http://localhost:1111/api/auth/oauth/security-test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1111",
              "path": ["api", "auth", "oauth", "security-test"]
            },
            "description": "Matching state value must be accepted (CSRF defense passes)."
          },
          "response": []
        },
        {
          "name": "State - mismatched state (CSRF attack)",
          "id": "oauth-state-mismatch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('valid is false', function () { pm.expect(pm.response.json().valid).to.eql(false); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test\": \"state\",\n  \"receivedState\": \"attacker-supplied-state\",\n  \"expectedState\": \"abc123\"\n}"
            },
            "url": {
              "raw": "http://localhost:1111/api/auth/oauth/security-test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1111",
              "path": ["api", "auth", "oauth", "security-test"]
            },
            "description": "Simulates a CSRF attempt with a forged/mismatched state value. Must be rejected (valid: false), but still HTTP 200 since this is a testing endpoint reporting a validation outcome."
          },
          "response": []
        },
        {
          "name": "State - missing state",
          "id": "oauth-state-missing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('valid is false', function () { pm.expect(pm.response.json().valid).to.eql(false); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test\": \"state\",\n  \"expectedState\": \"abc123\"\n}"
            },
            "url": {
              "raw": "http://localhost:1111/api/auth/oauth/security-test",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1111",
              "path": ["api", "auth", "oauth", "security-test"]
            },
            "description": "receivedState omitted entirely — must be rejected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Nonce (OIDC Replay) Validation",
      "item": [
        {
          "name": "Nonce - valid matching nonce",
          "id": "oauth-nonce-valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('valid is true', function () { pm.expect(pm.response.json().valid).to.eql(true); });"
                ]
